<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>SkillArena / {{ data.benchmark }}</title>
<style>
:root{--bg:#f3f6f1;--ink:#152c25;--muted:#597066;--line:#d8e2d8;--accent:#176a4e}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,sans-serif}main{max-width:1120px;margin:auto;padding:45px 24px 80px}h1{font-size:clamp(2rem,5vw,3.3rem);line-height:1.1;margin:12px 0 20px}h2{font-size:1.35rem;margin-top:36px}p{color:var(--muted)}.eyebrow{font-size:12px;letter-spacing:.14em;font-weight:800;color:var(--accent)}.meta{display:flex;flex-wrap:wrap;gap:12px;font-size:13px}.pill{border:1px solid var(--line);border-radius:99px;padding:5px 12px;background:white}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;margin:28px 0}.card{background:white;border:1px solid var(--line);border-radius:14px;padding:22px}.number{font-size:42px;font-weight:800;line-height:1.25}.sub{font-size:13px;color:var(--muted)}.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;background:white}th,td{text-align:left;padding:12px 14px;border:1px solid var(--line);font-size:14px}th{color:var(--muted);font-weight:600}.passed{color:#176a4e;font-weight:700}.failed,.infrastructure_error{color:#ad3b26;font-weight:700}.note{background:#e5eee3;border-left:4px solid var(--accent);padding:15px 20px;margin:24px 0}.note p{margin:5px 0}code{font-size:12px;overflow-wrap:anywhere}a{color:var(--accent)}@media(max-width:600px){main{padding:24px 12px}.meta{font-size:12px}th,td{padding:8px}}
</style></head><body><main>
<div class="eyebrow">SKILLARENA / AGENT EVALUATION</div>
<h1>{{ data.benchmark|replace('-', ' ')|title }}</h1>
<p>Audited tool use, independent scoring, and skill version comparisons.</p>
<div class="meta"><span class="pill">{{ data.runner.model }} · {{ data.runner.reasoning_effort }}</span><span class="pill">{{ data.tasks|length }} independent tasks × {{ data.repetitions }} repetitions</span><span class="pill">{{ data.evidence_level }}</span><span class="pill">{{ 'Complete' if data.complete else 'Partial result' }}</span></div>
<div class="cards">{% for name, arm in data.summary.conditions.items() %}<section class="card"><div>{{ name }}</div><div class="number">{% if arm.pass_rate is not none %}{{ (arm.pass_rate*100)|round(1) }}%{% else %}—{% endif %}</div><div class="sub">{{ arm.passed }} / {{ arm.scored }} scored runs passed</div><div class="sub">{{ arm.infrastructure_error }} infrastructure errors · {{ arm.not_run }} not run</div></section>{% endfor %}</div>
{% if data.stop_reason %}<div class="note">Stopped: {{ data.stop_reason }}</div>{% endif %}
<h2>Condition and version comparisons</h2><p>Differences use complete paired tasks. Positive values favor the right condition.</p>
<div class="scroll"><table><thead><tr><th>Comparison</th><th>Pass-rate change</th><th>Tasks: improved / tied / regressed</th><th>Evidence</th></tr></thead><tbody>
{% for item in data.summary.comparisons %}<tr><td>{{ item.left_condition }} → {{ item.right_condition }}</td><td>{% if item.delta is not none %}{{ '%+.1f'|format(item.delta*100) }} pp{% else %}Unavailable{% endif %}</td><td>{{ item.improvements }} / {{ item.ties }} / {{ item.regressions }}</td><td>{% if item.ci95 %}95% task bootstrap interval: {{ (item.ci95[0]*100)|round(1) }} to {{ (item.ci95[1]*100)|round(1) }} pp{% else %}Descriptive only · insufficient or incomplete task sample{% endif %}<br>{{ item.excluded_pairs }} excluded pairs · {{ item.complete_tasks }} complete tasks</td></tr>{% endfor %}
</tbody></table></div>
<p class="sub">Intervals are suppressed for fewer than five tasks, incomplete pairs, or no observed task variation. A tie does not establish equivalence.</p>
{% for item in data.summary.comparisons %}<details><summary>{{ item.left_condition }} → {{ item.right_condition }} · per-task outcomes</summary><div class="scroll"><table><thead><tr><th>Task</th><th>Outcome</th><th>Change</th></tr></thead><tbody>{% for task_id, task in item.per_task.items() %}<tr><td>{{ task_id }}</td><td>{{ task.outcome }}</td><td>{% if task.delta is not none %}{{ '%+.1f'|format(task.delta*100) }} pp{% else %}Incomplete{% endif %}</td></tr>{% endfor %}</tbody></table></div></details>{% endfor %}
<h2>Every agent run</h2><div class="scroll"><table><thead><tr><th>Task / repetition</th><th>Condition</th><th>Outcome</th><th>Tool calls</th><th>Skill read</th><th>Seconds</th><th>Evidence</th></tr></thead><tbody>
{% for run in data.runs %}<tr><td>{{ run.task_id }} / {{ run.repetition }}</td><td>{{ run.condition }}</td><td class="{{ run.status }}">{{ run.status|replace('_',' ') }}</td><td>{{ run.runner.tool_calls|default('—') }}</td><td>{{ 'Yes' if run.runner.skill_loaded else 'No' }}</td><td>{{ run.runner.duration_seconds|default('—') }}</td><td>{% if run.status != 'not_run' %}<a href="{{ evidence_base }}/runs/{{ run.id }}/tools.jsonl">Tools</a> · <a href="{{ evidence_base }}/runs/{{ run.id }}/evaluation.json">Score</a> · <a href="{{ evidence_base }}/runs/{{ run.id }}/workspace/output.json">Output</a>{% else %}—{% endif %}</td></tr>{% endfor %}
</tbody></table></div>
<h2>Scope and reproducibility</h2><div class="note">{% for note in data.limitations %}<p>{{ note }}</p>{% endfor %}</div>
<p>Suite: {{ data.suite.id }} / {{ data.suite.version }} · Created: {{ data.created_at }}</p>
<p><a href="{{ evidence_base }}/metrics.json">Metrics</a> · <a href="{{ evidence_base }}/plan.json">Frozen run plan</a> · <a href="{{ evidence_base }}/manifest.json">Integrity manifest</a> · <a href="{{ evidence_base }}/environment.json">Environment</a></p>
<p class="sub">Offline integrity check: <code>skillarena verify &lt;this-directory&gt;</code>. Integrity checks do not certify performance or provenance.</p>
</main></body></html>
